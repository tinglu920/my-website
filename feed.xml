</figure>
<figure class="post__image"><img loading="lazy" src="https://tingyinglu.com/media/posts/27/Qiang-Zhi_Wei-Bei-Chu-Li-De-Ji-Xiang-03_01-Da-2.jpeg" alt="" width="702" height="468" sizes="(max-width: 1024px) 100vw, 1024px" srcset="https://tingyinglu.com/media/posts/27/responsive/Qiang-Zhi_Wei-Bei-Chu-Li-De-Ji-Xiang-03_01-Da-2-xs.jpeg 300w ,https://tingyinglu.com/media/posts/27/responsive/Qiang-Zhi_Wei-Bei-Chu-Li-De-Ji-Xiang-03_01-Da-2-sm.jpeg 480w ,https://tingyinglu.com/media/posts/27/responsive/Qiang-Zhi_Wei-Bei-Chu-Li-De-Ji-Xiang-03_01-Da-2-md.jpeg 768w ,https://tingyinglu.com/media/posts/27/responsive/Qiang-Zhi_Wei-Bei-Chu-Li-De-Ji-Xiang-03_01-Da-2-lg.jpeg 1024w">
